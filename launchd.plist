<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.openai.codex.figma-plugin-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/bun</string>
    <string>/Users/apple/.codex/figma-plugin-mcp/bridge.mjs</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>FIGMA_LOCAL_PORT</key>
    <string>18428</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/apple/.codex/figma-plugin-mcp/bridge.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/apple/.codex/figma-plugin-mcp/bridge.log</string>
</dict>
</plist>
